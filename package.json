{
	"name": "@pressbooks/pressbooks-saml-sso",
	"description": "SAML2 Single Sign-On integration for Pressbooks (Shibboleth, Microsoft ADFS, Google Apps, etc.).",
	"type": "module",
	"scripts": {
		"build": "pressbooks-build-tools build",
		"watch": "pressbooks-build-tools dev",
		"lint:scripts": "pressbooks-build-tools lint:scripts 'assets/src/scripts/**/*.js'",
		"lint:styles": "pressbooks-build-tools lint:styles 'assets/src/styles/**/*.scss'",
		"fix:scripts": "pressbooks-build-tools fix:scripts 'assets/src/scripts/**/*.js'",
		"fix:styles": "pressbooks-build-tools fix:styles 'assets/src/styles/**/*.scss'",
		"lint": "npm run lint:scripts && npm run lint:styles"
	},
	"engines": {
		"node": ">= 22"
	},
	"dependencies": {},
	"devDependencies": {
		"pressbooks-build-tools": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pressbooks/pressbooks-saml-sso.git"
	},
	"author": "Book Oven Inc. <code@pressbooks.com>",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/pressbooks/pressbooks-saml-sso/issues"
	},
	"homepage": "https://github.com/pressbooks/pressbooks-saml-sso/",
	"eslintConfig": {
		"extends": "./node_modules/pressbooks-build-tools/config/eslint.cjs"
	},
	"stylelint": {
		"extends": "./node_modules/pressbooks-build-tools/config/stylelint.js"
	}
}
