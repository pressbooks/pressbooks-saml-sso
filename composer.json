{
	"name": "pressbooks/pressbooks-saml-sso",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"description": "Shibboleth Single Sign-On integration for Pressbooks.",
	"homepage": "https://github.com/pressbooks/pressbooks-saml-sso",
	"authors": [
		{
			"name": "Book Oven Inc.",
			"email": "code@pressbooks.com",
			"homepage": "https://pressbooks.org"
		}
	],
	"keywords": ["ebooks", "publishing", "webbooks"],
	"support": {
		"email": "code@pressbooks.com",
		"issues": "https://github.com/pressbooks/pressbooks-saml-sso/issues/",
		"source": "https://github.com/pressbooks/pressbooks-saml-sso/"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"require": {
		"php": "^8.3",
		"composer/installers": "^2.1",
		"onelogin/php-saml": "^4.1",
		"pressbooks/frontend-tools": "^1.0.0"
	},
	"require-dev": {
		"laravel/pint": "^1.10",
		"yoast/phpunit-polyfills": "^1.1.0"
	},
	"autoload": {
		"psr-4": {
			"PressbooksSamlSso\\": "src/"
		},
		"files": [
			"src/helpers.php"
		]
	},
	"scripts": {
		"test": [
			"vendor/bin/phpunit --configuration phpunit.xml"
		],
		"test-coverage": [
			"vendor/bin/phpunit --configuration phpunit.xml --coverage-clover coverage.xml"
		],
		"fix": [
			"vendor/bin/pint"
		],
		"standards": [
			"vendor/bin/pint --test"
		]
	}
}
